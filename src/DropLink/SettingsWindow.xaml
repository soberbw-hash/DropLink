<Window x:Class="DropLink.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLink 设置" Width="620" SizeToContent="Height" MaxHeight="900" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="True"
        Background="{StaticResource PageBackground}" FontFamily="{StaticResource AppFont}" UseLayoutRounding="True">
 <Window.Resources>
  <!-- One card per subject, rows split by hairlines. The old panel placed every
       control by absolute Left/Top, which is why it read as a wall. -->
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="{StaticResource Surface}"/>
   <Setter Property="CornerRadius" Value="14"/>
   <Setter Property="Padding" Value="22,16"/>
   <Setter Property="Margin" Value="0,0,0,12"/>
   <Setter Property="BorderBrush" Value="{StaticResource Border}"/>
   <Setter Property="BorderThickness" Value="1"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="FontWeight" Value="Medium"/>
   <Setter Property="Foreground" Value="{StaticResource TextTertiary}"/>
   <Setter Property="Margin" Value="2,0,0,8"/>
  </Style>
 </Window.Resources>

 <Border Background="{StaticResource PageBackground}">
  <StackPanel Margin="28,22,28,18">
   <TextBlock Text="设置" FontSize="23" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
   <TextBlock Text="改完立刻生效，不用点保存。" Style="{StaticResource BodyText}" Margin="0,6,0,18"/>

   <TextBlock Text="常规" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="这台电脑在 iPhone 上显示的名字" Style="{StaticResource RowTitle}"/>
       <TextBlock Text="隔空投送列表里看到的就是它。留空则用电脑名。" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <Grid Grid.Column="1" Width="220">
       <TextBox x:Name="DeviceNameBox" Padding="9,7" FontSize="13.5" Foreground="{StaticResource TextPrimary}"
                Background="{StaticResource SurfaceMuted}" BorderBrush="{StaticResource Border}" BorderThickness="1"
                VerticalContentAlignment="Center" MaxLength="40" LostFocus="DeviceName_Commit" KeyDown="DeviceName_KeyDown"/>
       <TextBlock x:Name="DeviceNamePlaceholder" IsHitTestVisible="False" Foreground="{StaticResource TextTertiary}" FontSize="13.5"
                  Margin="12,0,0,0" VerticalAlignment="Center"/>
      </Grid>
     </Grid>

     <Border Style="{StaticResource Hairline}" Margin="0,14"/>

     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="文件保存位置" Style="{StaticResource RowTitle}"/>
       <TextBlock x:Name="FolderText" Text="" Style="{StaticResource RowHint}" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="更改" Style="{StaticResource GhostButton}" Click="ChangeFolder_Click"/>
       <Button Content="打开" Style="{StaticResource LinkButton}" Margin="12,0,0,0" VerticalAlignment="Center" Click="OpenFolder_Click"/>
      </StackPanel>
     </Grid>

     <Border Style="{StaticResource Hairline}" Margin="0,14"/>

     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="开机自动启动" Style="{StaticResource RowTitle}"/>
       <TextBlock x:Name="AutostartHint" Text="登录 Windows 后在后台开始接收，不弹窗口、不弹 UAC。" Style="{StaticResource RowHint}"
                  TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="360"/>
      </StackPanel>
      <CheckBox x:Name="AutostartSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                Checked="Autostart_Toggled" Unchecked="Autostart_Toggled"/>
     </Grid>
    </StackPanel>
   </Border>

   <TextBlock Text="接收" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="自动接收" Style="{StaticResource RowTitle}"/>
       <TextBlock Text="收到请求直接接受，不弹确认框。关掉后每次都要你点一下。" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <CheckBox x:Name="AutoReceiveSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                Checked="ReceiveSetting_Toggled" Unchecked="ReceiveSetting_Toggled"/>
     </Grid>

     <Border Style="{StaticResource Hairline}" Margin="0,14"/>

     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="实况图额外存一张静态图" Style="{StaticResource RowTitle}"/>
       <TextBlock Text="iPhone 的实况照片是「视频 + 图」的包，多存一张普通图方便直接看和发。" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <CheckBox x:Name="LivePhotoSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                Checked="ReceiveSetting_Toggled" Unchecked="ReceiveSetting_Toggled"/>
     </Grid>

     <Border Style="{StaticResource Hairline}" Margin="0,14"/>

     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="通知里补充可查看的格式" Style="{StaticResource RowTitle}"/>
       <TextBlock Text="只在这种信息从文件名看不出来时才出现（比如实况图）。" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <CheckBox x:Name="FormatSwitch" Grid.Column="1" Style="{StaticResource Switch}" VerticalAlignment="Center"
                Checked="ReceiveSetting_Toggled" Unchecked="ReceiveSetting_Toggled"/>
     </Grid>
    </StackPanel>
   </Border>

   <TextBlock Text="设备维护" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <TextBlock Text="网卡驱动" Style="{StaticResource RowTitle}"/>
     <TextBlock Text="换 WinUSB 是接收隔空投送的必要步骤，随时可以回退成原厂驱动。" Style="{StaticResource RowHint}"/>
     <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
      <Button Content="检查网卡驱动" Style="{StaticResource GhostButton}" Click="CheckDriver_Click"/>
      <Button Content="回退成原厂驱动" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="Rollback_Click"/>
     </StackPanel>
     <TextBlock x:Name="MaintenanceResult" Style="{StaticResource RowHint}" MinHeight="17" TextWrapping="Wrap" Margin="0,10,0,0"/>
    </StackPanel>
   </Border>

   <TextBlock Text="关于与帮助" Style="{StaticResource SectionTitle}"/>
   <Border Style="{StaticResource Card}">
    <StackPanel>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0">
       <TextBlock Text="DropLink" Style="{StaticResource RowTitle}"/>
       <TextBlock x:Name="VersionText" Text="" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="导出诊断包" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="Diagnostics_Click"/>
     </Grid>
     <Border Style="{StaticResource Hairline}" Margin="0,14"/>
     <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Grid.Column="0" Margin="0,0,20,0">
       <TextBlock Text="接收历史" Style="{StaticResource RowTitle}"/>
       <TextBlock x:Name="HistoryHint" Text="首页显示最近三次。清空列表不会删除已经收到的文件。" Style="{StaticResource RowHint}"/>
      </StackPanel>
      <Button Grid.Column="1" Content="清空列表" Style="{StaticResource GhostButton}" VerticalAlignment="Center" Click="ClearHistory_Click"/>
     </Grid>
    </StackPanel>
   </Border>

   <Grid Margin="0,4,0,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <!-- Fixed height: SizeToContent would otherwise make the window jump every
         time a note appears. -->
    <TextBlock x:Name="StatusText" Grid.Column="0" FontSize="12.5" Foreground="{StaticResource TextTertiary}"
               VerticalAlignment="Center" TextWrapping="Wrap" MinHeight="18" Margin="0,0,16,0"/>
    <Button x:Name="DoneButton" Grid.Column="1" Content="完成" Style="{StaticResource PrimaryButton}" Click="Done_Click"/>
   </Grid>
  </StackPanel>
 </Border>
</Window>
