<Window x:Class="DropLink.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="DropLink 设置" Width="520" SizeToContent="Height" MaxHeight="720" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBackground}"
        FontFamily="{StaticResource AppFont}" FontWeight="Normal" TextOptions.TextFormattingMode="Display" UseLayoutRounding="True">
 <Window.Resources>
  <Style x:Key="SettingLabel" TargetType="TextBlock" BasedOn="{StaticResource RowTitle}">
   <Setter Property="VerticalAlignment" Value="Center"/>
  </Style>
 </Window.Resources>
 <ScrollViewer x:Name="SettingsScroll" Background="{StaticResource PageBackground}" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
  <StackPanel Margin="24,20,24,18">
   <TextBlock Text="接收设置" Style="{StaticResource StatusTitle}" HorizontalAlignment="Left" Margin="0,0,0,16"/>
   <Border Background="{StaticResource Surface}" CornerRadius="12" BorderThickness="1" BorderBrush="{StaticResource Border}" Padding="18,16">
    <StackPanel>
     <TextBlock Text="隔空投送名称" Style="{StaticResource SettingLabel}"/>
     <DockPanel Margin="0,7,0,0">
      <Button DockPanel.Dock="Right" x:Name="SaveNameButton" Content="保存" Style="{StaticResource GhostButton}" Margin="8,0,0,0" Click="SaveName_Click" IsEnabled="False"/>
      <Border CornerRadius="5" Background="{StaticResource SurfaceMuted}" BorderThickness="1" BorderBrush="{StaticResource Border}">
       <Grid>
        <TextBox x:Name="DeviceNameBox" AutomationProperties.Name="隔空投送名称" Background="Transparent" BorderThickness="0" Padding="10,6" FontSize="14" MaxLength="40" VerticalContentAlignment="Center" LostFocus="DeviceName_Commit" KeyDown="DeviceName_KeyDown" TextChanged="DeviceName_TextChanged"/>
        <TextBlock x:Name="DeviceNamePlaceholder" Margin="11,0" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" IsHitTestVisible="False" TextTrimming="CharacterEllipsis"/>
       </Grid>
      </Border>
     </DockPanel>
     <Border Style="{StaticResource Hairline}" Margin="0,13"/>
     <DockPanel>
      <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
       <Button Content="更改" Style="{StaticResource LinkButton}" Margin="10,0" Click="ChangeFolder_Click"/>
       <Button Content="打开" Style="{StaticResource LinkButton}" Click="OpenFolder_Click"/>
      </StackPanel>
      <StackPanel>
       <TextBlock Text="保存位置" Style="{StaticResource SettingLabel}"/>
       <TextBlock x:Name="FolderText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" Style="{StaticResource RowHint}"/>
      </StackPanel>
     </DockPanel>
     <Border Style="{StaticResource Hairline}" Margin="0,13"/>
     <DockPanel>
      <CheckBox DockPanel.Dock="Right" x:Name="AutoReceiveSwitch" AutomationProperties.Name="自动接收" Style="{StaticResource Switch}" Checked="ReceiveSetting_Toggled" Unchecked="ReceiveSetting_Toggled"/>
      <StackPanel>
       <TextBlock Text="自动接收" Style="{StaticResource SettingLabel}"/>
       <TextBlock Text="收到文件时免确认" Style="{StaticResource RowHint}"/>
      </StackPanel>
     </DockPanel>
     <Border Style="{StaticResource Hairline}" Margin="0,13"/>
     <DockPanel>
      <CheckBox DockPanel.Dock="Right" x:Name="AutostartSwitch" AutomationProperties.Name="登录后在后台启动" Style="{StaticResource Switch}" Checked="Autostart_Toggled" Unchecked="Autostart_Toggled"/>
      <TextBlock Text="登录后在后台启动" Style="{StaticResource SettingLabel}"/>
     </DockPanel>
    </StackPanel>
   </Border>
   <Expander Header="设备与诊断" Margin="2,14,0,0" FontSize="13">
    <StackPanel Margin="16,10,0,4">
     <WrapPanel><Button Content="检查驱动" Style="{StaticResource GhostButton}" Click="CheckDriver_Click"/><Button Content="恢复原厂驱动" Style="{StaticResource GhostButton}" Margin="8,0" Click="Rollback_Click"/><Button Content="导出诊断包" Style="{StaticResource GhostButton}" Click="Diagnostics_Click"/></WrapPanel>
     <TextBlock x:Name="MaintenanceResult" Style="{StaticResource RowHint}" TextWrapping="Wrap"/>
    </StackPanel>
   </Expander>
   <DockPanel Margin="0,16,0,0">
    <Button x:Name="DoneButton" DockPanel.Dock="Right" Content="完成" Style="{StaticResource PrimaryButton}" Click="Done_Click"/>
    <StackPanel VerticalAlignment="Center" Margin="0,0,10,0">
     <TextBlock x:Name="VersionText" Style="{StaticResource Caption}"/>
     <TextBlock x:Name="StatusText" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" FontSize="12" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    </StackPanel>
   </DockPanel>
  </StackPanel>
 </ScrollViewer>
</Window>
