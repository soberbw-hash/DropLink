<Window x:Class="DropLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DropLink" Width="800" Height="600" MinWidth="600" MinHeight="460" Background="#F5F7FB" FontFamily="Segoe UI">
 <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="DropLink" FontSize="32" FontWeight="SemiBold" Foreground="#17233C"/><TextBlock Text="隔空投送接收 · 开发预览" Foreground="#66758D" Margin="0,4,0,24"/></StackPanel>
 <Border Grid.Row="1" CornerRadius="14" Background="White" Padding="22" Margin="0,0,0,16"><StackPanel><TextBlock Text="接收服务" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="点击下方按钮检查接收条件。检查为只读，不会更改驱动、初始化网卡或发送无线帧。" TextWrapping="Wrap" Foreground="#66758D" Margin="0,8,0,12"/><StackPanel Orientation="Horizontal"><Button Content="检查接收条件" HorizontalAlignment="Left" Padding="18,8" Click="CheckReadiness_Click"/><Button Content="开启接收" x:Name="StartButton" IsEnabled="False" HorizontalAlignment="Left" Padding="18,8" Margin="12,0,0,0" Click="StartReceive_Click"/></StackPanel><TextBox x:Name="ReceiveStatus" Text="尚未检查。点击“检查接收条件”查看当前状态。" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="Transparent" Foreground="#44536B" Margin="0,12,0,0" MaxHeight="200" VerticalScrollBarVisibility="Auto"/></StackPanel></Border>
 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="14" Background="White" Padding="22" Margin="0,0,8,0"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="设备检查" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="重新扫描" Margin="20,0,0,0" Padding="12,5" Click="Scan_Click"/></StackPanel><TextBox x:Name="Devices" Text="正在只读扫描设备…" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Border><Border Grid.Column="1" CornerRadius="14" Background="White" Padding="22"><DockPanel><TextBlock DockPanel.Dock="Top" Text="接收记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="Transfers" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Files}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Sender}" Foreground="#66758D"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Progress}" Margin="8,0,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Grid>
 <TextBlock Grid.Row="3" Text="兼容性需要硬件型号、接口和实机测试共同确认。" Foreground="#66758D" Margin="0,16,0,0"/>
 </Grid>
</Window>
