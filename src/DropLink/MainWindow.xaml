<Window x:Class="DropLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="DropLink" Width="820" Height="640" MinWidth="640" MinHeight="500" Background="#F5F7FB" FontFamily="{StaticResource AppFont}">
 <Grid Margin="36"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
 <StackPanel><TextBlock Text="DropLink" FontSize="30" FontWeight="SemiBold" Foreground="#17233C"/><TextBlock Text="把 iPhone 的照片和文件隔空投送到这台电脑" Foreground="#66758D" Margin="0,4,0,20"/></StackPanel>

 <!-- Guided primary card: always tells the user where they are and what to do next. -->
 <Border Grid.Row="1" CornerRadius="16" Background="White" Padding="26,22" Margin="0,0,0,14" BorderBrush="#E4E9F2" BorderThickness="1">
  <StackPanel>
   <!-- Step indicator -->
   <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
    <Border x:Name="Step1Box" CornerRadius="16" Padding="12,5" Background="#EAF0FF"><TextBlock x:Name="Step1Text" Text="1  换驱动" Foreground="#2C6BED" FontWeight="SemiBold"/></Border>
    <TextBlock Text="→" Foreground="#AEB9CC" Margin="10,0,10,0" VerticalAlignment="Center"/>
    <Border x:Name="Step2Box" CornerRadius="16" Padding="12,5" Background="#F0F2F6"><TextBlock x:Name="Step2Text" Text="2  开启接收" Foreground="#95A1B5" FontWeight="SemiBold"/></Border>
    <TextBlock Text="→" Foreground="#AEB9CC" Margin="10,0,10,0" VerticalAlignment="Center"/>
    <Border x:Name="Step3Box" CornerRadius="16" Padding="12,5" Background="#F0F2F6"><TextBlock x:Name="Step3Text" Text="3  收文件" Foreground="#95A1B5" FontWeight="SemiBold"/></Border>
   </StackPanel>

   <TextBlock x:Name="GuideStepLabel" Text="正在检查…" FontSize="13" Foreground="#2C6BED" FontWeight="SemiBold" Margin="0,0,0,6"/>
   <TextBlock x:Name="GuideTitle" Text="正在检查设备与驱动…" FontSize="25" FontWeight="SemiBold" Foreground="#17233C" TextWrapping="Wrap"/>
   <TextBlock x:Name="GuideDetail" Text="" FontSize="14" Foreground="#52627C" TextWrapping="Wrap" Margin="0,8,0,18" LineHeight="22"/>

   <Button x:Name="GuideAction" Content="检查接收条件" HorizontalAlignment="Left" Padding="26,12" FontSize="15" FontWeight="SemiBold" Foreground="White" Background="#2C6BED" BorderBrush="#2C6BED" Click="GuideAction_Click"/>

   <TextBox x:Name="ReceiveStatus" Text="" IsReadOnly="True" TextWrapping="Wrap" BorderThickness="0" Background="#F7F9FC" Foreground="#7C889C" FontSize="12" Padding="10" Margin="0,16,0,0" MaxHeight="150" VerticalScrollBarVisibility="Auto" Visibility="Collapsed"/>
   <StackPanel Orientation="Horizontal" Margin="0,12,0,0" Opacity="0.75">
    <Button Content="详细报告" Padding="2,0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#8B97AC" Cursor="Hand" Click="ToggleDetails_Click"/>
    <Button Content="· 回退驱动" Padding="2,0" FontSize="11" Background="Transparent" BorderThickness="0" Foreground="#B23A48" Cursor="Hand" Click="Rollback_Click" Margin="12,0,0,0"/>
   </StackPanel>
  </StackPanel>
 </Border>

 <Grid Grid.Row="2"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border CornerRadius="14" Background="White" Padding="22" Margin="0,0,8,0" BorderBrush="#E4E9F2" BorderThickness="1"><DockPanel><StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12"><TextBlock Text="设备检查" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/><Button Content="重新扫描" Margin="20,0,0,0" Padding="12,5" Click="Scan_Click"/></StackPanel><TextBox x:Name="Devices" Text="正在只读扫描设备…" IsReadOnly="True" BorderThickness="0" Background="Transparent" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/></DockPanel></Border><Border Grid.Column="1" CornerRadius="14" Background="White" Padding="22" BorderBrush="#E4E9F2" BorderThickness="1"><DockPanel><TextBlock DockPanel.Dock="Top" Text="接收记录" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/><ListBox x:Name="Transfers" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12"><TextBlock Text="{Binding Files}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Sender}" Foreground="#66758D"/><StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Progress}" Margin="8,0,0,0"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></DockPanel></Border></Grid>
 <TextBlock Grid.Row="3" Text="检查为只读，不会更改驱动、发送无线帧或启动程序。驱动切换与回退都需要你授权确认。" Foreground="#8B97AC" FontSize="12" Margin="0,14,0,0"/>
 </Grid>
</Window>
