<Window x:Class="DropLink.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DropLink"
        Title="DropLink" Width="440" Height="580" MinWidth="380" MinHeight="480"
        Background="{StaticResource PageBackground}" FontFamily="{StaticResource AppFont}"
        ShowInTaskbar="True" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
 <Window.Resources>
  <local:KindIconConverter x:Key="KindIcon"/>
  <!-- The AirDrop mark, drawn rather than shipped as a bitmap so it stays sharp
       at every DPI. Same geometry as the icon design file. -->
  <Geometry x:Key="AirMarkOuter">M41,120 A58,58 0 1 1 119,120</Geometry>
  <Geometry x:Key="AirMarkMiddle">M53,105 A40,40 0 1 1 107,105</Geometry>
  <Geometry x:Key="AirMarkInner">M65,91 A22,22 0 1 1 95,91</Geometry>
  <Geometry x:Key="GearGlyph">M4,7 H20 M4,12 H20 M4,17 H20</Geometry>

  <Storyboard x:Key="Breathe">
   <DoubleAnimation Storyboard.TargetName="MarkGroup" Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:1.1" AutoReverse="True" RepeatBehavior="Forever"/>
  </Storyboard>
  <Storyboard x:Key="Spin">
   <DoubleAnimation Storyboard.TargetName="SpinAngle" Storyboard.TargetProperty="Angle" From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever"/>
  </Storyboard>
  <Storyboard x:Key="PulseDot">
   <DoubleAnimation Storyboard.TargetName="ReadyDot" Storyboard.TargetProperty="Opacity" From="1" To="0.3" Duration="0:0:0.7" AutoReverse="True" RepeatBehavior="Forever"/>
  </Storyboard>

  <!-- One row per received batch. The whole row is the click target: open the
       file, or the folder for a batch. -->
  <DataTemplate x:Key="HistoryRow">
   <Border x:Name="row" CornerRadius="10" Background="Transparent" Padding="8,7" Margin="0,1" Cursor="Hand"
           MouseLeftButtonUp="HistoryRow_Click" ToolTip="{Binding Target}">
    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <Border Grid.Column="0" Width="32" Height="32" CornerRadius="8" Background="{StaticResource SurfaceMuted}">
      <Path Data="{Binding Kind, Converter={StaticResource KindIcon}}" Stroke="{StaticResource TextSecondary}"
            StrokeThickness="1.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
            Width="18" Height="18" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
      <TextBlock Text="{Binding Title}" Style="{StaticResource RowTitle}" TextTrimming="CharacterEllipsis"/>
      <TextBlock Text="{Binding Subtitle}" Style="{StaticResource RowHint}"/>
     </StackPanel>
     <TextBlock Grid.Column="2" Text="›" FontSize="15" Foreground="{StaticResource TextTertiary}" VerticalAlignment="Center" Margin="0,0,4,0"/>
    </Grid>
   </Border>
   <DataTemplate.Triggers>
    <Trigger SourceName="row" Property="IsMouseOver" Value="True">
     <Setter TargetName="row" Property="Background" Value="{StaticResource SurfaceMuted}"/>
    </Trigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>

 <Border Background="{StaticResource PageBackground}">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <!-- ── A. brand ─────────────────────────────────────────────────────── -->
   <Grid Grid.Row="0" Margin="20,16,14,4">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <Border Grid.Column="0" Width="26" Height="26" CornerRadius="7" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1">
     <Viewbox Width="16" Height="14">
      <Canvas Width="160" Height="140">
       <Path Data="{StaticResource AirMarkOuter}" Stroke="{StaticResource Brand}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Path Data="{StaticResource AirMarkInner}" Stroke="{StaticResource Brand}" StrokeThickness="9" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Ellipse Canvas.Left="73" Canvas.Top="69" Width="14" Height="14" Fill="{StaticResource Brand}"/>
      </Canvas>
     </Viewbox>
    </Border>
    <TextBlock Grid.Column="1" Text="DropLink" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center" Margin="9,0,0,0"/>
    <Button Grid.Column="2" x:Name="SettingsButton" Style="{StaticResource IconButton}" Click="Settings_Click" ToolTip="设置">
     <Canvas Width="18" Height="18">
      <Path Data="{StaticResource GearGlyph}" Stroke="{StaticResource TextSecondary}" StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
      <Ellipse Canvas.Left="4.5" Canvas.Top="4.5" Width="4" Height="4" Fill="{StaticResource TextSecondary}"/>
      <Ellipse Canvas.Left="12.5" Canvas.Top="9.5" Width="4" Height="4" Fill="{StaticResource TextSecondary}"/>
      <Ellipse Canvas.Left="7.5" Canvas.Top="14.5" Width="4" Height="4" Fill="{StaticResource TextSecondary}"/>
     </Canvas>
    </Button>
   </Grid>

   <!-- ── B. status: exactly one panel is visible ───────────────────────── -->
   <!-- The air mark lives once, above the panels, so every state has the same
        visual anchor. It used to sit inside the idle panel only, which left a
        blank block at the top of the confirm/paused/failed screens and made
        them look like something had failed to load. -->
   <Grid Grid.Row="1" Margin="28,4,28,10">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <Grid x:Name="MarkHost" Grid.Row="0" Height="112" HorizontalAlignment="Center">
     <Viewbox x:Name="MarkGroup" Width="112" Height="98" VerticalAlignment="Center">
      <Canvas Width="160" Height="140">
       <Path Data="{StaticResource AirMarkOuter}" Stroke="{StaticResource Brand}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Path Data="{StaticResource AirMarkMiddle}" Stroke="{StaticResource Brand}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Path Data="{StaticResource AirMarkInner}" Stroke="{StaticResource Brand}" StrokeThickness="7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
       <Ellipse Canvas.Left="74.5" Canvas.Top="70.5" Width="11" Height="11" Fill="{StaticResource Brand}"/>
      </Canvas>
     </Viewbox>
     <!-- Busy ring, only while the radio is actually being brought up. -->
     <Grid x:Name="Spinner" Width="96" Height="96" Visibility="Collapsed">
      <Ellipse Stroke="{StaticResource Divider}" StrokeThickness="2.5"/>
      <Ellipse Stroke="{StaticResource Brand}" StrokeThickness="2.5" StrokeDashArray="4 14" StrokeDashCap="Round" RenderTransformOrigin="0.5,0.5">
       <Ellipse.RenderTransform><RotateTransform x:Name="SpinAngle"/></Ellipse.RenderTransform>
      </Ellipse>
     </Grid>
    </Grid>

    <Grid Grid.Row="1">
     <!-- Waiting / preparing / done -->
     <StackPanel x:Name="IdlePanel" VerticalAlignment="Center">
      <TextBlock x:Name="IdleTitle" Text="等待接收" Style="{StaticResource StatusTitle}"/>
      <TextBlock x:Name="IdleLine" Text="在 iPhone 的隔空投送中选择" Style="{StaticResource BodyText}"
                 HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock x:Name="IdleDevice" Text="" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"
                 HorizontalAlignment="Center" Margin="0,6,0,0" TextTrimming="CharacterEllipsis" MaxWidth="300"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
       <Ellipse x:Name="ReadyDot" Width="6" Height="6" Fill="{StaticResource Success}" VerticalAlignment="Center"/>
       <TextBlock x:Name="ReadyLine" Text="接收服务已就绪" Style="{StaticResource Caption}" Margin="7,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
     </StackPanel>

     <!-- Receiving / saving -->
     <StackPanel x:Name="TransferPanel" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="TransferHeadline" Text="正在接收" FontSize="15" FontWeight="Medium" Foreground="{StaticResource TextPrimary}"/>
      <TextBlock x:Name="TransferFrom" Text="" Style="{StaticResource BodyText}" Margin="0,3,0,0"/>
      <TextBlock x:Name="TransferPercent" Text="0%" FontSize="34" FontWeight="Medium" Foreground="{StaticResource TextPrimary}" Margin="0,10,0,0"/>
      <ProgressBar x:Name="TransferBar" Style="{StaticResource TransferBar}" Margin="0,6,0,0"/>
      <Grid Margin="0,8,0,0">
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBlock x:Name="TransferReceived" Grid.Column="0" Style="{StaticResource Caption}"/>
       <TextBlock x:Name="TransferRemaining" Grid.Column="1" Style="{StaticResource Caption}"/>
      </Grid>
      <TextBlock x:Name="TransferNote" Text="" Style="{StaticResource Caption}" Margin="0,6,0,0" TextWrapping="Wrap"/>
     </StackPanel>

     <!-- Manual confirmation, in-window: a modal box would block the receiver
          and steal focus from whatever the user was doing. -->
     <StackPanel x:Name="ConfirmPanel" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock Text="收到发送请求" Style="{StaticResource StatusTitle}"/>
      <TextBlock x:Name="ConfirmFrom" Text="" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
      <TextBlock x:Name="ConfirmFiles" Text="" Style="{StaticResource Caption}" HorizontalAlignment="Center" TextAlignment="Center"
                 TextTrimming="CharacterEllipsis" MaxWidth="320" Margin="0,4,0,0"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,18,0,0">
       <Button x:Name="AcceptButton" Content="接收" Style="{StaticResource PrimaryButton}" Click="Accept_Click"/>
       <Button x:Name="DeclineButton" Content="拒绝" Style="{StaticResource GhostButton}" Margin="10,0,0,0" Click="Decline_Click"/>
      </StackPanel>
     </StackPanel>

     <!-- Setup / paused / failure: one sentence, one action. -->
     <StackPanel x:Name="ActionPanel" VerticalAlignment="Center" Visibility="Collapsed">
      <TextBlock x:Name="ActionTitle" Text="暂时无法接收" Style="{StaticResource StatusTitle}" TextWrapping="Wrap"/>
      <TextBlock x:Name="ActionDetail" Text="" Style="{StaticResource BodyText}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,8,0,0"/>
      <Button x:Name="ActionButton" Content="重试" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Center" Margin="0,18,0,0" Click="ActionButton_Click"/>
      <Button x:Name="ActionSecondary" Content="查看原因" Style="{StaticResource LinkButton}" HorizontalAlignment="Center" Margin="0,10,0,0"
              Visibility="Collapsed" Click="ActionSecondary_Click"/>
     </StackPanel>
    </Grid>
   </Grid>

   <!-- ── C. recent ────────────────────────────────────────────────────── -->
   <StackPanel Grid.Row="2" Margin="20,0,20,0">
    <Border Style="{StaticResource Hairline}" Margin="0,0,0,10"/>
    <Grid Margin="8,0,8,2">
     <TextBlock Text="最近接收" Style="{StaticResource SectionHeader}"/>
     <Button x:Name="OpenFolderButton" Content="打开文件夹" Style="{StaticResource LinkButton}" HorizontalAlignment="Right" Click="OpenFolder_Click"/>
    </Grid>
    <ItemsControl x:Name="RecentList" ItemTemplate="{StaticResource HistoryRow}" Margin="0,2,0,6" Focusable="False"/>
    <TextBlock x:Name="RecentEmpty" Text="收到的文件会显示在这里" Style="{StaticResource Caption}" Margin="8,6,0,10"/>
   </StackPanel>

   <!-- ── footer ───────────────────────────────────────────────────────── -->
   <TextBlock x:Name="FooterText" Grid.Row="3" Text="DropLink · 原生隔空投送接收工具" Style="{StaticResource Caption}"
              HorizontalAlignment="Center" Margin="0,2,0,12"/>
  </Grid>
 </Border>
</Window>
