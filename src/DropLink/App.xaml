<Application x:Class="DropLink.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" ShutdownMode="OnExplicitShutdown">
 <Application.Resources>
  <ResourceDictionary>
   <ResourceDictionary.MergedDictionaries>
    <!-- Colour, spacing and control shape live in one dictionary so both
         windows read the same tokens instead of hard-coding hex per element. -->
    <ResourceDictionary Source="Theme.xaml"/>
   </ResourceDictionary.MergedDictionaries>
   <!-- HarmonyOS Sans SC (open source, SIL OFL) embedded as resource; works on any PC without installing. -->
   <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#HarmonyOS Sans SC</FontFamily>
  </ResourceDictionary>
 </Application.Resources>
</Application>
