<Application x:Class="DropLink.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#386DE8"/>
  <!-- HarmonyOS Sans SC (open source, SIL OFL) embedded as resource; works on any PC without installing. -->
  <FontFamily x:Key="AppFont">pack://application:,,,/Fonts/#HarmonyOS Sans SC</FontFamily>
 </Application.Resources>
</Application>
