+    def reject_unread_upload(self, status, reason):
+        """Send a rejection and briefly drain a small, already-sent body.
+
+        Windows can reset a TLS connection with unread data before the sender
+        receives the response. Never wait for an Expect: 100-continue body or
+        consume an unbounded upload; this connection will always close.
+        """
+        self.reject(status, reason)
+        if self.headers.get('Expect', '').lower() == '100-continue':
+            return
+        try:
+            length = int(self.headers.get('Content-Length', '0'))
+        except ValueError:
+            return
+        if not 0 < length <= 65536:
+            return
+        timeout = self.request.gettimeout()
+        deadline = time.monotonic() + 0.25
+        try:
+            while length:
+                remaining = deadline - time.monotonic()
+                if remaining <= 0:
+                    break
+                self.request.settimeout(remaining)
+                data = self.rfile.read1(min(length, 65536))
+                if not data:
+                    break
+                length -= len(data)
+        except (OSError, TimeoutError):
+            pass
+        finally:
+            self.request.settimeout(timeout)
+
