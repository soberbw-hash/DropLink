+/* Read-only device inventory. Prints one JSON object to stdout and exits
+ * WITHOUT opening, resetting or claiming any device — no driver, firmware or
+ * radio operation. Lets a host map PnP interfaces to libusb bus/port paths;
+ * empty when libusb enumerates no matching adapter. Never starts the radio. */
+int list_devices() {
+    libusb_context *ctx = nullptr;
+    if (libusb_init(&ctx) != 0) {
+        std::fprintf(stderr, "{\"error\":\"libusb_init failed\"}\n");
+        return 1;
+    }
+    libusb_device **list = nullptr;
+    const ssize_t n = libusb_get_device_list(ctx, &list);
+    std::printf("[");
+    int printed = 0;
+    for (ssize_t i = 0; i < n; ++i) {
+        libusb_device_descriptor dd{};
+        if (libusb_get_device_descriptor(list[i], &dd) != 0) continue;
+        uint8_t ports[8] = {};
+        const int pc = libusb_get_port_numbers(list[i], ports, sizeof(ports));
+        std::string path;
+        for (int p = 0; p < pc; ++p) {
+            if (!path.empty()) path += '.';
+            path += std::to_string(ports[p]);
+        }
+        std::printf("%s{\"bus\":%u,\"port\":\"%s\",\"vid\":%u,\"pid\":%u}",
+                    printed++ ? "," : "", libusb_get_bus_number(list[i]),
+                    path.c_str(), dd.idVendor, dd.idProduct);
+    }
+    if (list != nullptr) libusb_free_device_list(list, 1);
+    libusb_exit(ctx);
+    std::printf("]\n");
+    return 0;
+}
